<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_model_sheet"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_model_badge" />

    <!-- Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖  AI Model"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Active model indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_model_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_ai_avatar" />

            <TextView
                android:id="@+id/tv_current_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemma 2B"
                android:textColor="#22D3EE"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_model_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="20dp"
        android:text="Size: 1.2 GB"
        android:textColor="#6B7DB3"
        android:textSize="12sp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:background="#1A2A3F" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:text="SELECT MODEL"
        android:textColor="#6B7DB3"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1" />

    <!-- ═══ Gemma Card ═══ -->
    <LinearLayout
        android:id="@+id/card_gemma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_model_card"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Radio indicator replaced by custom dot -->
            <RadioButton
                android:id="@+id/rb_gemma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#22D3EE" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemma 2B"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/gemma_desc"
                    android:textColor="#6B7DB3"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Specs + Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~1.2 GB"
                    android:textColor="#4A5580"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_gemma_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Not loaded"
                    android:textColor="#6B7DB3"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_model_badge" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Qwen Card ═══ -->
    <LinearLayout
        android:id="@+id/card_qwen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_model_card"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioButton
                android:id="@+id/rb_qwen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#22D3EE" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qwen 2.5-0.5B"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/qwen_desc"
                    android:textColor="#6B7DB3"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~1 GB"
                    android:textColor="#4A5580"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_qwen_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Not loaded"
                    android:textColor="#6B7DB3"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_model_badge" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ TinyLlama Card ═══ -->
    <LinearLayout
        android:id="@+id/card_tinyllama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_model_card"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioButton
                android:id="@+id/rb_tinyllama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#22D3EE" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TinyLlama 1.1B"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tinyllama_desc"
                    android:textColor="#6B7DB3"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~0.7 GB"
                    android:textColor="#4A5580"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_tinyllama_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Not loaded"
                    android:textColor="#6B7DB3"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_model_badge" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:background="#1A2A3F" />

    <!-- Load Model Button -->
    <Button
        android:id="@+id/btn_load_model"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="📂  Load Model File"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_model_load_button"
        android:stateListAnimator="@null" />

    <!-- Info text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:text="Download models from Hugging Face or Google Drive.\nSelect a .task file to load."
        android:textColor="#4A5580"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp" />

</LinearLayout>